<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MicroKit.Result</AssemblyName>
    <RootNamespace>MicroKit.Result</RootNamespace>
    <Description>Railway-oriented result type for .NET 10. Explicit success/failure without exceptions.</Description>
    <PackageTags>microkit;result;railway;functional;dotnet</PackageTags>
    <NoWarn>$(NoWarn);CA1716;CA1000</NoWarn>
  </PropertyGroup>

</Project>
