{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Ged": {
        "Provider": "postgres",
        "PostgresMajorVersion": 16,
        "Storage": {
            "RootPath": "./ged-storage",
            "DefaultBucket": "ged",
            "ProviderName": "filesystem"
        },
        "Uploads": {
            "Detector": "builtin",
            "AllowedFormats": [
                "pdf",
                "docx",
                "xlsx",
                "pptx",
                "odt",
                "ods",
                "odp",
                "txt",
                "csv",
                "jpeg",
                "png",
                "tiff",
                "bmp"
            ],
            "MaxSizeBytes": 268435456,
            "MaxSizeByFormat": {
                "txt": 10485760,
                "csv": 10485760,
                "rtf": 10485760,
                "png": 26214400,
                "jpeg": 26214400,
                "bmp": 26214400,
                "tiff": 52428800
            },
            "FormatsByDocType": {
                "CONTRACT": ["pdf"],
                "INVOICE": ["pdf", "xlsx", "ods"]
            },
            "EnforceDeclaredMediaType": false
        }
    },
    "Auth": {
        "Authority": "https://localhost:5001",
        "Audience": "ged-api"
    },
    "Cors": {
        "Origins": []
    },
    "ConnectionStrings": {
        "Ged": ""
    }
}
