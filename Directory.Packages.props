<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MicroKitVersion Condition="'$(MicroKitVersion)' == ''">1.0.0-preview.5</MicroKitVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MicroKit.Domain" Version="$(MicroKitVersion)" />
    <PackageVersion Include="MicroKit.Persistence.Abstractions" Version="$(MicroKitVersion)" />
  </ItemGroup>
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.4" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageVersion Include="dbup-postgresql" Version="6.0.4" />
    <PackageVersion Include="dbup-sqlserver" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup Label="Api">
    <!-- Asp.Versioning 10.x is the first release built for ASP.NET Core 10 and the built-in
         OpenAPI library. v8 still runs via roll-forward but predates the integration below. -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.13.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
  </ItemGroup>
</Project>
