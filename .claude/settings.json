{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "claude-opus-5",
    "permissions": {
        "allow": [
            "Bash(dotnet build *)",
            "Bash(dotnet test *)",
            "Bash(dotnet format *)",
            "Bash(git status *)",
            "Bash(git log *)",
            "Bash(git diff *)",
            "Bash(./scripts/check-dockerfile-copies.sh:*)",
            "Bash(./scripts/repo-map.sh:*)"
        ],
        "deny": [
            "Bash(git push * main)",
            "Bash(git push origin main)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo 'Mini GED Repos session started'"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-delete-branch.sh"
                    }
                ]
            }
        ]
    }
}