# Copy to .env for local work. .env is gitignored and never baked into an image.
#
# In production these come from the orchestrator's secret store — a connection string in an image
# layer or in `docker history` is a credential leak that survives every later fix.

POSTGRES_PASSWORD=ged
MSSQL_SA_PASSWORD=Ged!Passw0rd

AUTH_AUTHORITY=https://localhost:5001
AUTH_AUDIENCE=ged-api
CORS_ORIGIN=https://localhost:5173
