<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Ged.Api</RootNamespace>
    <UserSecretsId>ged-platform-api</UserSecretsId>
    <!-- The composition root wires types the trimmer cannot see through configuration, so it is
         excluded from trimming even though every library below it is trimmable. -->
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ged.Features/Ged.Features.csproj" />
    <ProjectReference Include="../Ged.Adapters.Persistence.PostgreSql/Ged.Adapters.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="../Ged.Adapters.Persistence.SqlServer/Ged.Adapters.Persistence.SqlServer.csproj" />
    <ProjectReference Include="../Ged.Adapters.Storage.FileSystem/Ged.Adapters.Storage.FileSystem.csproj" />
  </ItemGroup>

</Project>
